# Base URL of the OneEngine backend API. Prefer a same-origin path ("/api") served by a
# reverse proxy; an absolute URL needs CORS with credentials on the backend.
VITE_API_BASE_URL=/api
# When "true", services resolve against the in-browser mock layer instead of the API.
# Ignored in production builds unless VITE_ALLOW_MOCKS_IN_PRODUCTION=true (demo builds only).
VITE_USE_MOCKS=true
# Request timeout in milliseconds
VITE_API_TIMEOUT=30000
# Dev server only (never bundled): backend that /api is proxied to when VITE_USE_MOCKS=false
API_PROXY_TARGET=http://localhost:5000
