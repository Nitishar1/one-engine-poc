# true = use the fake backend in src/mocks (dev only). false = call the real API.
VITE_USE_MOCKS=true
# Where the app sends API calls. Keep "/api" and let the dev server forward it (below).
VITE_API_BASE_URL=/api
# Dev server only: the real backend that /api is forwarded to when VITE_USE_MOCKS=false.
API_PROXY_TARGET=http://localhost:5000
