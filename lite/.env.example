# Where the app sends API calls. Keep "/api" and let the dev server forward it (below).
VITE_API_BASE_URL=/api
# true = answer API calls from the mock backend in src/mocks (development only).
VITE_USE_MOCKS=true
# Request timeout in milliseconds.
VITE_API_TIMEOUT=30000
# Dev server only (never bundled): the real backend that /api is forwarded to.
# OneEngine.Api under IIS: API_PROXY_TARGET=http://localhost/OneEngine.Api
API_PROXY_TARGET=http://localhost:5000
